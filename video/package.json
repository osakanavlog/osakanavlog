{
  "name": "intemize-pr-video",
  "version": "1.0.0",
  "description": "株式会社インテマイズ PR動画（BtoC / BtoB）",
  "scripts": {
    "studio": "remotion studio",
    "render": "npm run render:btoc && npm run render:btob",
    "render:btoc": "remotion render PR-BtoC out/intemize-pr-btoc.mp4",
    "render:btob": "remotion render PR-BtoB out/intemize-pr-btob.mp4",
    "preview": "remotion render PR-BtoC out/preview.mp4 --scale=0.5",
    "still": "remotion still PR-BtoC out/thumbnail.png --frame=120",
    "bgm": "node tools/make-bgm.mjs",
    "compositions": "remotion compositions",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@remotion/cli": "^4.0.523",
    "@remotion/transitions": "^4.0.523",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.523"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
