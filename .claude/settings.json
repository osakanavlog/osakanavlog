{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/obsidian-logger.mjs\" SessionStart",
            "timeout": 10,
            "statusMessage": "Obsidian にノートを作成中..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/obsidian-resume.mjs\"",
            "timeout": 10,
            "statusMessage": "前回までのやり取りを読み込んでいます..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/obsidian-logger.mjs\" UserPromptSubmit",
            "timeout": 10,
            "statusMessage": "Obsidian に質問を記録中..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/obsidian-recall.mjs\"",
            "timeout": 10,
            "statusMessage": "Obsidian から関連ノートを探しています..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/obsidian-logger.mjs\" Stop",
            "timeout": 10,
            "statusMessage": "Obsidian に回答を記録中..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/obsidian-logger.mjs\" SessionEnd",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node \"$CLAUDE_PROJECT_DIR/.claude/tools/obsidian.mjs\" search:*)",
      "Bash(node \"$CLAUDE_PROJECT_DIR/.claude/tools/obsidian.mjs\" read:*)",
      "Bash(node \"$CLAUDE_PROJECT_DIR/.claude/tools/obsidian.mjs\" list:*)",
      "Bash(node \"$CLAUDE_PROJECT_DIR/.claude/tools/obsidian.mjs\" links:*)",
      "Bash(node \"$CLAUDE_PROJECT_DIR/.claude/tools/obsidian.mjs\" tags:*)",
      "Bash(node \"$CLAUDE_PROJECT_DIR/.claude/tools/obsidian.mjs\" recall:*)"
    ]
  },
  "enabledMcpjsonServers": [
    "obsidian"
  ]
}
